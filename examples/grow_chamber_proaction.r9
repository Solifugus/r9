# Grow chamber — the PROACTION half
#
# The companion to grow_chamber.r9, written 2026-09-19 against the provisional
# vocabulary of §34.3: `pursue`, `using`, `compute`. As before, the point is to
# find where the language cannot say what was meant. Gaps are numbered and
# collected at the end.
#
# The first finding is not in the list, because it is about the boundary
# itself: **writing this half revealed that the REACTION half is incomplete.**
# PROACTION may not write an input (§31.2), so everything it wants must already
# exist as a declared state and a transition. The chamber has none for the
# lamp, so `LIT` and `DARK` below do not yet exist and must be added there.
# That is the boundary working as designed — intent has to be declared before
# it can be wanted — but it means the two halves cannot be written apart.


# What the chamber believes between power cuts (§34.3).
# GAP 1: `durable` is invented. The design settles that durability is declared
# rather than ambient; it does not say what declaring it looks like.

durable let last_watered  = never          # GAP 2
durable let soak_estimate = 2min
durable let failed_waters = 0
durable let lamp_today    = 0s
durable let help_asked    = false

const LIGHT_HOURS = 14h
const RISE        = 2%       # a watering that raises the probe by less did nothing


# --------------------------------------------------------------- pursuits

pursue KEEP_CLIMATE

    loop
        let target = TARGET_NIGHT
        if is_daytime()                                  # GAP 3
            target = TARGET_DAY
        end

        # An outside forecast is a resource, not a dependency (§34.1). If it
        # does not answer, this pursuit proceeds without it.
        let f = compute weather.forecast()
        await f.status == DONE within 10s
        else
        end
        if f.status == DONE and f.value.warm_afternoon
            target = target - 1C                         # GAP 4
        end

        using CLIMATE within 1min

            let a = transition AT_TEMP(target)

            await a.status == SUCCEEDED or a.status == FAILED within 45min
            else
                log("climate still trying after 45min")
            end

            if a.status == FAILED
                log("climate failed: {reason}", reason = a.reason)
            end

        else
            log("CLIMATE is held by something else")
        end

        await false within 10min                         # GAP 5
        else
        end
    end

end


pursue WATER_WHEN_DRY

    loop
        await IRRIGATION.moisture < DRY_LEVEL

        if help_asked
            await false within 1h                        # GAP 5
            else
            end
        else
            using IRRIGATION within 30min

                let before = IRRIGATION.moisture
                log("watering, soil at {before}", before = before)

                let a = transition MOIST

                await a.status == SUCCEEDED or a.status == FAILED
                        within soak_estimate + 1min
                else
                end

                let after = IRRIGATION.moisture
                log("watered, soil {after} was {before}", after = after, before = before)

                if after - before < RISE
                    failed_waters = failed_waters + 1
                else
                    failed_waters = 0
                    last_watered = now                   # GAP 6

                    # What did the last few waterings actually take? Learning,
                    # such as it is: an estimate from this machine's own history.
                    let e = compute estimate_soak(log.matching("watered"))   # GAP 7
                    await e.status == DONE within 5s
                    else
                    end
                    if e.status == DONE
                        soak_estimate = e.value
                    end
                end

                if failed_waters >= 3
                    ask_operator("three waterings have not raised the soil")  # GAP 8
                    help_asked = true
                end

            else
                log("IRRIGATION is held by something else")
            end
        end
    end

end


pursue LIGHT_BUDGET

    loop
        if lamp_today < LIGHT_HOURS and is_daytime()     # GAP 3

            using LIGHTING within 5min

                let started = now                        # GAP 6
                let a = transition LIT                   # does not exist yet — see header

                if a.status == SUCCEEDED
                    await lamp_today + (now - started) >= LIGHT_HOURS within 4h
                    else
                    end
                end

                let b = transition DARK
                lamp_today = lamp_today + (now - started)

            else
                log("LIGHTING is held by something else")
            end
        end

        await false within 15min                         # GAP 5
        else
        end
    end

end


pursue ASK_WHEN_STUCK

    # An empty tank is not something any transition can fix, which is what
    # makes it PROACTION's problem rather than REACTION's.

    loop
        await TANK.empty

        if help_asked == false
            ask_operator("the water tank is empty")      # GAP 8
            help_asked = true
        end

        await TANK.empty == false
        help_asked = false
        log("tank refilled")
    end

end


# ----------------------------------------------------- watchers that inform

# REACTION has already taken the machine somewhere safe by the time these run.
# These only record, for whatever later decides something (§34.3).

watch CLIMATE.faulted
    if CLIMATE.faulted
        log("CLIMATE faulted: {reason}", reason = CLIMATE.fault_reason)   # GAP 9
    end
end

watch IRRIGATION.faulted
    if IRRIGATION.faulted
        log("IRRIGATION faulted: {reason}", reason = IRRIGATION.fault_reason)
    end
end


# GAP 10: there is nowhere to put the idle fallback. §34.3 says "nothing is
# being pursued" should be an observable condition with a declared response —
# reassess, summarise the day into the log, ask whether anything is worth
# doing. Nothing here can say that.


# ------------------------------------------------------ what could not be said
#
#  1. Durable state has no declaration. `durable let` is invented. The design
#     says durability is declared and bounded; the spelling is missing, and so
#     is any way to state the bound.
#
#  2. `never` again — an instant that has not happened. Second program to want
#     it, which strengthens the case in §42 for deciding about absence.
#
#  3. No calendar and no time of day. `is_daytime()` cannot be written: an
#     instant is a point in time, and R9 has nothing for civil time, sunrise,
#     or "every day at 06:00". A grow chamber is mostly a scheduler, so this
#     is the single biggest hole this program found. RV-9 has no clock at boot
#     either, so it is a co-design question, not only a language one.
#
#  4. `target - 1C` is the offset-unit problem from the other file, again: a
#     temperature minus a temperature difference.
#
#  5. There is no way to simply wait. `await false within 10min else end` is a
#     deliberate absurdity standing in for it. A pursuit that should act every
#     ten minutes, or at six in the morning, has no way to say so. This wants
#     solving with (3).
#
#  6. `now` is still missing, and needed more here than in the other half.
#
#  7. The log's read side is invented: `log.matching("watered")`. So is
#     reaching an attribute of an entry, which `estimate_soak` would need to
#     compare the before and after values anchored in those lines. §42 asks
#     what search matches; a program wants attribute predicates too — "every
#     entry whose `after` minus `before` is under 2%".
#
#  8. `ask_operator` has nothing behind it. §34.5 says PROACTION should be able
#     to reach an operator and names no mechanism. Asking for help is what an
#     autonomous machine does when it has exhausted what it can do alone, so
#     this deserves better than a library call invented in an example.
#
#  9. `.faulted` and `.fault_reason` are used everywhere in the design and
#     declared nowhere (also GAP 12 in the other file).
#
# 10. The idle fallback has no home. Pursuits exist, but "nothing is being
#     pursued" is a property of the set of them, and nothing can name that set.
#
# 11. Pursuit lifecycle is undefined. Every pursuit here is `loop ... end`
#     because that is the only shape available. What happens to a pursuit that
#     completes? What happens to one that faults — is the intent gone until a
#     restart, and does anything notice? §34.3 says a restored pursuit comes
#     back as intent, which implies the authority knows the set of them.
#
# 12. Importance cannot be expressed. If watering and lighting ever wanted the
#     same domain, first come first served decides, and nothing here can say
#     that dry soil matters more than an hour of light. §42 has this open; a
#     program makes it concrete in about twenty lines.
#
# 13. A program's own structure is undefined. These two files are one program.
#     §44.1 gives modules for libraries and says a file declares one module,
#     but nothing says how the halves of a program relate, or how the REACTION
#     half's names become visible here.
